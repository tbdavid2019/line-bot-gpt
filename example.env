# ==============================================================================
# LLM 核心設定 (4-Tier 高可用架構，支援智慧熔斷與防驚群 Jitter 退避)
# ==============================================================================
# Tier 1: 主要端點 (OpenAI API Compatible - llm.aiurl.tw)
OPEN_AI_BASE_PATH=https://llm.aiurl.tw/v1
OPEN_AI_MODEL=group/talk
OPEN_AI_LINE_SECRET=your_primary_llm_key

# Tier 2: Google Gemini 官方 OpenAI 相容端點 (百萬級 Context / 支援 Tool Calling)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LLM_MODEL=gemini-2.5-flash

# Tier 3: Groq 超高速推論端點
FALLBACK_LLM_BASE_PATH=https://api.groq.com/openai/v1
FALLBACK_LLM_MODEL=qwen/qwen3.8-27b
FALLBACK_LLM_KEY=your_groq_api_key

# Tier 4: 自訂備用端點 (可選：官方 OpenAI、DeepSeek、Ollama 等)
FALLBACK_CUSTOM_BASE_PATH=https://api.openai.com/v1
FALLBACK_CUSTOM_KEY=
FALLBACK_CUSTOM_MODEL=gpt-4o-mini

# LLM 智慧熔斷器與防驚群參數
LLM_CIRCUIT_FAIL_THRESHOLD=2
LLM_CIRCUIT_COOLDOWN_MS=45000
LLM_FATAL_COOLDOWN_MS=600000
LLM_TIMEOUT_MS=15000

# Session 與長效記憶設定 (預設 7 天超時自動開立新話題)
SESSION_TTL_DAYS=7

# Agentic Tool Calling 最大循環上限 (預設 10 輪)
MAX_AGENT_TURNS=10

# ==============================================================================
# AI 圖片生成與視覺設定 (Google REST API / 多端點容錯)
# ==============================================================================
IMAGE_API_BASE_PATH=https://llm.aiurl.tw/v1
IMAGE_API_KEY=your_image_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key
FALLBACK_IMAGE_API_KEY=your_gemini_api_key
FALLBACK_GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_ASR_MODEL=gemini-2.5-flash

# 圖片功能開關
ENABLE_IMAGE_ANALYSIS=true
ENABLE_IMAGE_EDITING=true

# Google Cloud Storage 設定 (可選，用於圖片存儲)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET_NAME=
GOOGLE_CLOUD_KEY_FILE=service-account-key.json

# 888box 資產管理與雲端存儲 (支援多端點高可用容錯)
BOX_BASE_URL=https://box.david888.com
BOX_FALLBACK_URLS=https://box.david888.com,https://box.glsoft.ai,https://box.aiurl.tw
BOX_API_TOKEN=

# 2MD 即時聯網搜尋 (SERP) 與網頁解析 (支援 3 端點高可用容錯與動態熔斷防驚群)
SERP_PRIMARY_URL=https://2md.aiurl.tw
SERP_FALLBACK_1_URL=https://2md.glsoft.ai
SERP_FALLBACK_2_URL=https://create360.ai
SERP_TIMEOUT_MS=10000
READ_PAGE_TIMEOUT_MS=10000
SERP_SIMPLIFIED_TIMEOUT_MS=6000
SERP_CIRCUIT_FAIL_THRESHOLD=2
SERP_CIRCUIT_COOLDOWN_MS=45000
SERP_CACHE_TTL_MS=180000

# David888 Wiki 知識庫設定
WIKI_BASE_URL=https://wiki.david888.com

# Google Maps API
GOOGLE_MAPS_API_KEY=

# ASR (語音辨識) API Keys
ASR_API_GROQ_KEY=
ASR_API_GEMINI_KEY=
ASR_API_OPENAI_KEY=

# Python RAG 服務設定
PYTHON_PATH=./venv/bin/python
RAG_SCRIPT_PATH=rag_service.py
