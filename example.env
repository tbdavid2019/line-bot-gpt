OPEN_AI_BASE_PATH=https://api.openai.com/v1
OPEN_AI_LINE_SECRET=sk-your-openai-api-key-here
PORT=8111
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_USER_ID=
OPEN_AI_MODEL=gpt-4o

# Gemini 設定（用於圖片分析）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image-preview
GEMINI_VISION_MODEL=gemini-2.5-flash

# 圖片功能開關（可選）
ENABLE_IMAGE_ANALYSIS=true
ENABLE_IMAGE_EDITING=true

# Google Cloud Storage 設定 (可選，用於圖片存儲)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET_NAME=
GOOGLE_CLOUD_KEY_FILE=service-account-key.json

# 888box 資產管理與雲端存儲 (支援多端點高可用容錯)
BOX_BASE_URL=https://box.david888.com
BOX_FALLBACK_URLS=https://box.david888.com,https://box.glsoft.ai,https://box.aiurl.tw
BOX_API_TOKEN=

# David888 Wiki 知識庫設定
WIKI_BASE_URL=https://wiki.david888.com

# Google Maps API
GOOGLE_MAPS_API_KEY=

# ASR (語音辨識) API Keys
ASR_API_GROQ_KEY=  # Groq Whisper API Key (免費額度可用)
ASR_API_GEMINI_KEY=  # Optional: 留空則使用上方的 GEMINI_API_KEY
ASR_API_OPENAI_KEY=  # Optional: 留空則使用上方的 OPEN_AI_LINE_SECRET
# Note: Bot 會根據已設定的 API Key 自動選擇可用的 ASR 服務

# Python RAG 服務設定
PYTHON_PATH=./venv/bin/python
RAG_SCRIPT_PATH=rag_service.py

# 注意：大同食譜 RAG 功能使用 OPEN_AI_LINE_SECRET 來生成 embedding
# 確保 OPEN_AI_LINE_SECRET 已設定，否則食譜搜尋功能無法運作
